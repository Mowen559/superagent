            "CodeContent": "/**\n * Normalizes an array of labels:\n * - CommonJS export of a single-parameter function\n * - Returns empty array if input is not an Array\n * - Does not mutate the original array\n * - Ignores non-string items\n * - Trims leading and trailing whitespace, discards empty items\n * - Case-insensitive stable deduplication, preserving the case of the first occurrence\n * - Built-in capabilities only\n *\n * @param {unknown} input\n * @returns {string[]}\n */\nfunction normalizeLabels(input) {\n  if (!Array.isArray(input)) {\n    return [];\n  }\n\n  const seen = new Set();\n  const result = [];\n\n  for (let i = 0; i < input.length; i++) {\n    const item = input[i];\n    if (typeof item !== 'string') {\n      continue;\n    }\n\n    const trimmed = item.trim();\n    if (trimmed.length === 0) {\n      continue;\n    }\n\n    const lowerKey = trimmed.toLowerCase();\n    if (!seen.has(lowerKey)) {\n      seen.add(lowerKey);\n      result.push(trimmed);\n    }\n  }\n\n  return result;\n}\n\nmodule.exports = normalizeLabels;\n",
            "TargetFile": "D:\\抖音\\deepcloud\\super-agent\\artifacts\\hub-scope-v3\\explicit-implementation\\hub-independent-94f48bba95604937aa0fa9130eb04ff0\\data\\runs\\4023a809-fc72-4817-93d0-fee96c2b1202\\workspace\\normalize-labels.cjs"
