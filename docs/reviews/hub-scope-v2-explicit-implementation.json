            "CodeContent": "/**\n * 规范化标签列表函数\n * - CommonJS 导出单参数函数\n * - 输入必须为数组，非数组输入返回空数组\n * - 不改写原数组\n * - 忽略非字符串项\n * - 清理首尾空白，丢弃空项\n * - 不区分大小写稳定去重，保留首次出现项的大小写\n *\n * @param {unknown} input\n * @returns {string[]}\n */\nfunction normalizeLabels(input) {\n  if (!Array.isArray(input)) {\n    return [];\n  }\n\n  const seen = new Set();\n  const result = [];\n\n  for (let i = 0; i < input.length; i++) {\n    const item = input[i];\n    if (typeof item !== 'string') {\n      continue;\n    }\n\n    const trimmed = item.trim();\n    if (trimmed.length === 0) {\n      continue;\n    }\n\n    const key = trimmed.toLowerCase();\n    if (!seen.has(key)) {\n      seen.add(key);\n      result.push(trimmed);\n    }\n  }\n\n  return result;\n}\n\nmodule.exports = normalizeLabels;\n"
          }
        },
